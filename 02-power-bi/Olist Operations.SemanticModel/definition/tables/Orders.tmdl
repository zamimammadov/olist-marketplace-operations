table Orders
	lineageTag: b4905d24-9d93-52f4-888a-b7a527cd807e

	column 'Order ID'
		dataType: string
		lineageTag: 91b51d64-1a73-5090-841d-88611baa2458
		sourceColumn: order_id
		summarizeBy: none

	column 'Purchase date'
		dataType: dateTime
		lineageTag: 215fe846-8d41-5052-94fe-86385a84717f
		sourceColumn: purchase_date
		summarizeBy: none
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column 'State'
		dataType: string
		lineageTag: 968d4167-d7f2-5a16-986d-af359c47fa23
		sourceColumn: customer_state
		summarizeBy: none

	column 'Status'
		dataType: string
		lineageTag: c710d4ad-2878-5144-b2de-004249c7be6e
		sourceColumn: order_status
		summarizeBy: none

	column 'Delivered date'
		dataType: dateTime
		lineageTag: 1e552791-c043-5ec2-a8e8-7f6f058a7c5c
		sourceColumn: delivered_date
		summarizeBy: none
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column 'Estimated date'
		dataType: dateTime
		lineageTag: 573f5654-1a93-5b1f-9265-f3b8af451f2a
		sourceColumn: estimated_date
		summarizeBy: none
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column 'Item count'
		dataType: int64
		lineageTag: 1cc0fddc-b4dd-5e05-858d-f122f4984afa
		sourceColumn: item_count
		summarizeBy: none

	column 'Payment count'
		dataType: int64
		lineageTag: 8019fc0e-df0b-5403-a06f-595d894c09d7
		sourceColumn: payment_count
